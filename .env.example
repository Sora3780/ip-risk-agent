# 공공데이터포털 - 한국저작권위원회 오픈소스SW 라이선스정보 서비스_GW
# 마이페이지 > 데이터활용 > Open API > 개발계정 의 "Decoding" 키
COPYRIGHT_API_KEY=

# KIPRIS Plus - 한국특허영문초록(KPA) / 기계번역용 국문초록
KIPRIS_ACCESS_KEY=

# Gemini - aistudio(기본) 또는 vertex
GEMINI_BACKEND=aistudio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_BACKEND=vertex 로 바꿀 때만 필요 (키 불필요, 서비스 계정 사용)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Google Drive 서비스 계정 JSON 키 경로 (Docs 를 읽으려면 필요)
GOOGLE_DRIVE_CREDENTIALS=

# Gemini 호출 튜닝
# thinking: low(기본) | high | off  — low 로 두면 3배 빠르고 판정은 동일
GEMINI_THINKING=low
# 분당 호출 수. 무료 등급은 10. 결제 후에는 올려야 병렬 효과가 난다
GEMINI_RPM=10
